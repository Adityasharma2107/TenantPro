# TenantPro Express Server Environment Variables
# Copy this file to server/.env and fill in your values

# Server Port
PORT=5000

# Client Application URL (supports comma-separated origins for production & local dev)
CLIENT_URL=http://localhost:5173,https://your-tenantpro-app.vercel.app

# MongoDB Connection String (Atlas cluster or local mongodb://localhost:27017/tenantpro)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/tenantpro?retryWrites=true&w=majority

# JWT Signing Secret (generate using `openssl rand -hex 32`)
JWT_SECRET=your_secure_random_jwt_secret_key_at_least_32_characters

# Deployment Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Cookie SameSite Setting ('lax' for same-domain/Docker, 'none' for decoupled Render+Vercel)
COOKIE_SAME_SITE=lax

# Cloudinary Storage Credentials (optional - server uses mock fallback if omitted)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
